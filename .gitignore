# ─────────────────────────────────────────────
# Jan Setu — .gitignore
# ─────────────────────────────────────────────

# ── Secrets / environment ──
.env
*.env
!.env.example
backend/.env

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/
build/
dist/

# ── Databases / local data ──
*.db
*.sqlite
*.sqlite3
backend/jan_setu.db
backend/uploads/
media/

# ── Node / frontend ──
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# ── Editors / OS ──
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── MS Office lock/temp files ──
~$*.docx
~$*.pptx
~$*.xlsx

# ── Logs ──
*.log
logs/
