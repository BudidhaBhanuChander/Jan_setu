# ─────────────────────────────────────────────────────────────
# Jan Setu — environment configuration
# Copy this file to `.env` and fill in values as needed.
# The app runs fully in demo mode with NO values set.
# ─────────────────────────────────────────────────────────────

# Database (defaults to a local SQLite file)
# DATABASE_URL=sqlite:///./jan_setu.db

# CORS: comma-separated origins, or * for all (demo default)
# CORS_ORIGINS=http://localhost:5173

# ── Voice Agent (Deepgram) ──────────────────────────────────
# Required only for the Voice Agent page. Get a key at deepgram.com.
# Without it, the rest of the app works normally and the voice
# endpoint reports that it is disabled.
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
TTS_MODEL=aura-2-asteria-en

# ── Optional real LLM for the AI agents ─────────────────────
# LLM_PROVIDER: none | openai | anthropic | gemini
# When "none" (or no key), agents use the built-in keyword simulation.
LLM_PROVIDER=none
LLM_API_KEY=
# Model name, e.g. gpt-4o-mini / claude-3-5-haiku-latest / gemini-1.5-flash
LLM_MODEL=
# Optional custom base URL (for OpenAI-compatible gateways)
LLM_BASE_URL=
LLM_TIMEOUT=20

# ── Autonomous SLA scheduler ────────────────────────────────
# When true, a background loop periodically runs the tracking agent's
# escalation check so SLA breaches are caught automatically.
SLA_SCHEDULER_ENABLED=false
SLA_CHECK_INTERVAL_MINUTES=15

# ── Admin utilities ─────────────────────────────────────────
# When true, POST /api/admin/reset will wipe and re-seed the demo DB.
# Keep this false outside of demos/presentations.
ALLOW_ADMIN_RESET=false
